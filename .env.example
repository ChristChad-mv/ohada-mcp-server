HOST=127.0.0.1
PORT=8080
MCP_PATH=/mcp
OHADA_DB_PATH=ohada_corpus.sqlite
OHADA_SYSCOHADA_DB_PATH=syscohada.sqlite

# Use the exact public hostnames in production. Do not use "*".
ENABLE_DNS_REBINDING_PROTECTION=true
ALLOWED_HOSTS=localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

STATELESS_HTTP=true
JSON_RESPONSE=true
MAX_REQUEST_BODY_SIZE=65536
MAX_SEARCH_RESULTS=10
MAX_QUERY_LENGTH=1000
SEARCH_SNIPPET_LENGTH=600

# Per-instance abuse protection. No question text or raw IP address is stored.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# Keep false unless requests always arrive through a trusted reverse proxy.
# Google Cloud Run / External HTTPS Load Balancer appends one proxy hop.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

MAX_QUERY_TERMS=32
MAX_CITATION_LENGTH=500
